# Copy to .env and fill in real values locally. Never commit .env itself
# (it's already in .gitignore) -- this file must only ever contain
# variable names and placeholders.

# Master switch for the optional LLM-driven AI Business Analyst (Phase 8).
# "false" (default) keeps the app on the deterministic Phase 4 pipeline
# with no outbound calls at all.
OMNI_LLM_ENABLED=false

# Required only when OMNI_LLM_ENABLED=true. Missing this falls back to
# the deterministic pipeline rather than breaking the app.
ANTHROPIC_API_KEY=

# All optional; shown with their defaults.
# OMNI_LLM_MODEL=claude-sonnet-5
# OMNI_LLM_MAX_TOKENS=1024
# OMNI_LLM_TIMEOUT_SECONDS=20
# OMNI_LLM_MAX_ITERATIONS=4
# OMNI_LLM_MAX_TOOL_CALLS=6

# OMNI_RETAIL_DB_PATH=omni_retail.db
